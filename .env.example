# ---------- Supabase (Project Settings > API) ----------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by API routes and the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://7starfoundation.org
NEXT_PUBLIC_WHATSAPP_NUMBER=917070818112

# ---------- Admin seed (used ONLY by `npm run seed:admin`, never by the website) ----------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---------- Google Drive archive (leave empty until configured) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional. Leave empty: the app creates a private folder "7 Star Foundation Archives" in your Drive.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
ARCHIVE_KEEP_DAYS=30
# Deletion of archived rows stays OFF until you set this to true after a verified test archive.
ARCHIVE_DELETE_ENABLED=false
# Random long string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
